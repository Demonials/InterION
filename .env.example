# Optional local overrides only. Normal InterION use needs no .env file.
# InterION automatically downloads its public Firebase config from its Vercel cloud.

# Optional: use a custom host registration file.
# INTERION_HOST_FILE=interion_host.json

# Optional: explicitly restrict clients to your LAN subnet.
# Example: INTERION_LAN_CIDR=192.168.1.0/24
# INTERION_LAN_CIDR=192.168.1.0/24

# Optional: enable secure cookies only if you configure HTTPS locally.
# INTERION_COOKIE_SECURE=false
