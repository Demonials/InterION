GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
INTERION_ADMIN_EMAIL=you@example.com
INTERION_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set true when serving over HTTPS. Keep false only for trusted local HTTP networks.
INTERION_COOKIE_SECURE=false
# Optional: INTERION_AUTH_DB=auth_users.json
